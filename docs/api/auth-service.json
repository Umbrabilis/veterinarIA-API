{
  "openapi": "3.1.0",
  "info": {
    "title": "VeterinarIA API â€” auth-service",
    "description": "Registro, login, emisiÃƒÂ³n de JWT (JWKS) y perfil de usuario.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Gateway local"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "AutenticaciÃ³n",
      "description": "Registro, login y sesiÃ³n del usuario autenticado"
    },
    {
      "name": "Usuarios",
      "description": "Perfil del usuario autenticado y directorio de veterinarios"
    }
  ],
  "paths": {
    "/api/v1/usuarios/me": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Perfil del usuario autenticado",
        "operationId": "miPerfil",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Actualiza el nombre del usuario autenticado",
        "operationId": "actualizarPerfil",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActualizarPerfilRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/usuarios/me/password": {
      "put": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Cambia la contraseÃ±a del usuario autenticado",
        "operationId": "cambiarPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CambiarPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "AutenticaciÃ³n"
        ],
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "AutenticaciÃ³n"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/usuarios/veterinarios": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Veterinarios activos (para agendar citas)",
        "operationId": "veterinarios",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VeterinarioResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/usuarios/veterinarios/{id}": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Un veterinario activo por id (lo usa citas-service para validar la cita)",
        "operationId": "veterinario",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/VeterinarioResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "AutenticaciÃ³n"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioResponse"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "tags": [
          "AutenticaciÃ³n"
        ],
        "summary": "Llave pÃºblica (JWKS) para validar los JWT emitidos",
        "operationId": "jwks",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActualizarPerfilRequest": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 150,
            "minLength": 0,
            "pattern": "^\\p{L}[\\p{L} .'-]*$"
          }
        },
        "required": [
          "nombre"
        ]
      },
      "UsuarioResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "rol": {
            "type": "string",
            "enum": [
              "ADMINISTRADOR",
              "VETERINARIO",
              "PROPIETARIO"
            ]
          }
        }
      },
      "CambiarPasswordRequest": {
        "type": "object",
        "properties": {
          "passwordActual": {
            "type": "string",
            "maxLength": 72,
            "minLength": 0
          },
          "passwordNueva": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8,
            "pattern": "^(?=.*\\p{L})(?=.*\\p{N}).*$"
          }
        },
        "required": [
          "passwordActual",
          "passwordNueva"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 150,
            "minLength": 0,
            "pattern": "^\\p{L}[\\p{L} .'-]*$"
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8,
            "pattern": "^(?=.*\\p{L})(?=.*\\p{N}).*$"
          },
          "rol": {
            "type": "string",
            "enum": [
              "ADMINISTRADOR",
              "VETERINARIO",
              "PROPIETARIO"
            ]
          }
        },
        "required": [
          "email",
          "nombre",
          "password",
          "rol"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresInSeconds": {
            "type": "integer",
            "format": "int64"
          },
          "usuario": {
            "$ref": "#/components/schemas/UsuarioResponse"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 0
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "VeterinarioResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "name": "bearerAuth",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}